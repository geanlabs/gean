riscv64 zkVM guests: no atomics or fences on tamago/riscv64

SP1 and OpenVM implement RV64IM: they reject A-extension instructions when
loading a program and abort on FENCE. A zkVM guest runs on one hart with no
interrupts, so on tamago/riscv64:

- internal/runtime/atomic uses plain loads and stores (the wasm
  implementation) instead of AMO and LR/SC assembly;
- the compiler does not intrinsify internal/runtime/atomic, sync/atomic or
  the sync aliases of them, and skips the interface switch caches, whose
  lookup is an inline atomic load;
- runtime.publicationBarrier is a RET instead of a FENCE.

diff --git a/src/cmd/compile/internal/ssagen/intrinsics.go b/src/cmd/compile/internal/ssagen/intrinsics.go
index e2eebd78..7b467587 100644
--- a/src/cmd/compile/internal/ssagen/intrinsics.go
+++ b/src/cmd/compile/internal/ssagen/intrinsics.go
@@ -2170,6 +2170,15 @@ func findIntrinsic(sym *types.Sym) intrinsicBuilder {
 	}
 
 	fn := sym.Name
+	// zkVM guests (tamago/riscv64) run on RV64IM machines without the A
+	// extension or fences. Atomics and the publication barrier are plain
+	// calls to the single-threaded implementations in internal/runtime/atomic
+	// and runtime (the only sync intrinsics are aliases of those), so no AMO,
+	// LR/SC or FENCE instruction is ever emitted.
+	if zkNoAtomics() && (pkg == "internal/runtime/atomic" || pkg == "sync/atomic" || pkg == "sync" ||
+		pkg == "runtime" && fn == "publicationBarrier") {
+		return nil
+	}
 	if ssa.IntrinsicsDisable {
 		if pkg == "internal/runtime/sys" && (fn == "GetCallerPC" || fn == "GrtCallerSP" || fn == "GetClosurePtr") ||
 			pkg == simdPackage {
@@ -2258,3 +2267,9 @@ func GenIntrinsicBody(fn *ir.Func) {
 	typecheck.Stmts(fn.Body)
 	ir.CurFunc = nil // we know CurFunc is nil at entry
 }
+
+// zkNoAtomics reports whether the target is a zkVM guest (tamago/riscv64),
+// which has no atomic memory operations and no memory fences.
+func zkNoAtomics() bool {
+	return buildcfg.GOOS == "tamago" && buildcfg.GOARCH == "riscv64"
+}
